{
  "manifest_version": 3,
  "name": "Translator and Vocabulary Book",
  "version": "1.0",
  "description": "Translate selected text, choose key vocabulary, and save for later review.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/vocabulary-merger.js", "scripts/content.js"],
      "css": ["styles/style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/icon.png", "views/welcome.html", "views/wordCard.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "default_title": "Text Translator & Vocabulary Saver",
    "default_popup": "views/popup.html"
  },
  "options_ui": {
    "page": "views/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}